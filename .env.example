# API Keys Configuration
# Copy this to .env.local or environment-specific files
# DO NOT commit this file to git

# ===================================
# OpenRouter API (Primary for AI operations)
# ===================================
# Required for: Transaction categorization, document analysis, insights generation
# Get your key at: https://openrouter.ai/keys
ANTHROPIC_API_KEY="sk-or-v1-xxxx-xxxx-xxxx-xxxx"

# ===================================
# Perplexity API (Optional - for research features)
# ===================================
# Get your key at: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY="pplx-xxxx-xxxx-xxxx-xxxx"

# ===================================
# Google AI API (Optional - for Google Gemini models)
# ===================================
# Get your key at: https://console.cloud.google.com/apis/credentials
GOOGLE_API_KEY="your-google-ai-api-key-here"

# ===================================
# Mistral AI API (Optional - for Mistral models)
# ===================================
# Get your key at: https://console.mistral.ai/api-keys
MISTRAL_API_KEY="your-mistral-api-key-here"

# ===================================
# xAI API (Optional - for Grok models)
# ===================================
# Get your key at: https://console.x.ai/
XAI_API_KEY="your-xai-api-key-here"

# ===================================
# Azure OpenAI API (Optional - for Azure AI models)
# ===================================
# Requires endpoint configuration in .taskmaster/config.json
AZURE_OPENAI_API_KEY="your-azure-openai-api-key-here"

# ===================================
# Ollama API (Optional - for local models)
# ===================================
# For self-hosted Ollama instances
OLLAMA_API_KEY="your-ollama-api-key-here"

# ===================================
# GitHub API (Optional - for import/export features)
# ===================================
# Get your key at: https://github.com/settings/tokens
# Format: ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx or github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_API_KEY="your-github-api-key-here"
