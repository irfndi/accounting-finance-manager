---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Multi-Entity Management - Finance Manager" description="Multi-entity consolidation and management">
  <div class="min-h-screen flex items-center justify-center bg-gray-50">
    <div class="max-w-md w-full bg-white rounded-lg shadow-lg p-8 text-center">
      <div class="mb-6">
        <div class="mx-auto w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mb-4">
          <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
          </svg>
        </div>
        <h1 class="text-2xl font-bold text-gray-900 mb-2">Multi-Entity Management</h1>
        <p class="text-gray-600">This feature is currently under development</p>
      </div>
      
      <div class="bg-green-50 border border-green-200 rounded-lg p-4 mb-6">
        <h3 class="font-semibold text-green-900 mb-2">Coming Soon</h3>
        <ul class="text-sm text-green-800 text-left space-y-1">
          <li>• Multi-company management</li>
          <li>• Consolidated reporting</li>
          <li>• Inter-company transactions</li>
          <li>• Entity-specific permissions</li>
          <li>• Cross-entity analytics</li>
        </ul>
      </div>
      
      <div class="space-y-3">
        <a 
          href="/dashboard" 
          class="w-full bg-green-600 text-white py-2 px-4 rounded-lg hover:bg-green-700 transition-colors inline-block"
        >
          ← Back to Dashboard
        </a>
        <a 
          href="/general-ledger" 
          class="w-full bg-gray-100 text-gray-700 py-2 px-4 rounded-lg hover:bg-gray-200 transition-colors inline-block"
        >
          Go to General Ledger
        </a>
      </div>
    </div>
  </div>
</Layout>