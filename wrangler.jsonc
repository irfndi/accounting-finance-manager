{
  // Cloudflare Workers configuration in JSONC format
  // NOTE: Top-level name is required for Cloudflare GitHub integration which deploys without --env flag
  "name": "fin-in-flow-prod",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client",
  },
  // Worker configuration
  "env": {
    "production": {
      "name": "fin-in-flow-prod",
      "vars": {
        "ALCHEMY_MANAGED": "true",
        "CONTAINER_VERSION": "1.0.0",
        "DEPLOYMENT_STRATEGY": "alchemy",
        "STAGE": "prod",
        "ENVIRONMENT": "production",
        "JWT_SECRET": "dev-jwt-secret-please-change-in-production-use-strong-random-key",
        "AUTH_SESSION_DURATION": "7d",
        "AWS_REGION": "us-east-1",
        "SES_FROM_EMAIL": "noreply@finance-manager.com",
        "SES_FROM_NAME": "Finance Manager",
      },
      "d1_databases": [
        {
          "binding": "FINANCE_MANAGER_DB",
          "database_name": "fininflow-db-prod",
          "database_id": "11bc7825-db1f-4ab4-8009-15254c808ba5",
          "migrations_dir": "migrations",
          "created": true,
          "read_replicas": true,
          "time_travel_enabled": true,
          "time_travel_days": 7,
          "jurisdiction": "us",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "FINANCE_MANAGER_CACHE",
          "id": "c76d938bc571430e8940547be8f2c689",
        },
      ],
      "r2_buckets": [
        {
          "binding": "FINANCE_MANAGER_DOCUMENTS",
          "bucket_name": "fininflow-documents-prod",
          "sql_enabled": true,
        },
      ],
      "ai": {
        "binding": "AI",
      },
    },
    "development": {
      "name": "finance-manager-dev",
      "vars": {
        "ALCHEMY_MANAGED": "true",
        "CONTAINER_VERSION": "1.0.0",
        "DEPLOYMENT_STRATEGY": "alchemy",
        "STAGE": "dev",
      },
    },
    "test": {
      "name": "finance-manager-test",
      "vars": {
        "ALCHEMY_MANAGED": "true",
        "CONTAINER_VERSION": "1.0.0",
        "DEPLOYMENT_STRATEGY": "alchemy",
        "STAGE": "test",
        "ENVIRONMENT": "test",
        "JWT_SECRET": "test-jwt-secret-key-for-testing-only",
        "AUTH_SESSION_DURATION": "1h",
        "AWS_REGION": "us-east-1",
        "SES_FROM_EMAIL": "test@finance-manager.com",
        "SES_FROM_NAME": "Finance Manager Test",
      },
      "d1_databases": [
        {
          "binding": "FINANCE_MANAGER_DB",
          "database_name": "test-finance-manager-db",
          "database_id": "test-db-id",
          "migrations_dir": "migrations",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "FINANCE_MANAGER_CACHE",
          "id": "test-kv-id",
        },
      ],
      "r2_buckets": [
        {
          "binding": "FINANCE_MANAGER_DOCUMENTS",
          "bucket_name": "test-finance-manager-documents",
        },
      ],
      "vectorize": [
        {
          "binding": "DOCUMENT_EMBEDDINGS",
          "index_name": "test-finance-manager-documents",
        },
      ],
    },
  },
  // Default variables - Using production values since GitHub integration deploys without --env
  "vars": {
    "ALCHEMY_MANAGED": "true",
    "CONTAINER_VERSION": "1.0.0",
    "DEPLOYMENT_STRATEGY": "alchemy",
    "STAGE": "prod",
    "ENVIRONMENT": "production",
    "JWT_SECRET": "dev-jwt-secret-please-change-in-production-use-strong-random-key",
    "AUTH_SESSION_DURATION": "7d",
    "AWS_REGION": "us-east-1",
    "SES_FROM_EMAIL": "noreply@finance-manager.com",
    "SES_FROM_NAME": "Finance Manager",
  },
  // D1 Database bindings - Using production
  "d1_databases": [
    {
      "binding": "FINANCE_MANAGER_DB",
      "database_name": "fininflow-db-prod",
      "database_id": "11bc7825-db1f-4ab4-8009-15254c808ba5",
      "migrations_dir": "migrations",
    },
  ],
  // KV Storage bindings - Using production
  "kv_namespaces": [
    {
      "binding": "FINANCE_MANAGER_CACHE",
      "id": "c76d938bc571430e8940547be8f2c689",
    },
  ],
  // Vectorize for ML embeddings - 10M vectors per index (doubled from 5M)
  "vectorize": [
    {
      "binding": "DOCUMENT_EMBEDDINGS",
      "index_name": "fininflow-documents-prod",
      "dimensions": 768,
      "metric": "cosine",
      "predicate_vector_count": 10000000,
    },
  ],
  // R2 Storage bindings - Using production
  "r2_buckets": [
    {
      "binding": "FINANCE_MANAGER_DOCUMENTS",
      "bucket_name": "fininflow-documents-prod",
    },
  ],
  // AI binding
  "ai": {
    "binding": "AI",
  },
  // Containers configuration for Go backend - Hybrid architecture
  "containers": [
    {
      "class_name": "FinanceContainer",
      "image": "./backend/Dockerfile",
      "max_instances": 20,
      "defaultPort": 8080,
      "sleepAfter": "10m",
      "instance_type": "standard-1",
    },
  ],
  // Module rules for WASM support
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": true,
    },
  ],
  // Observability
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
    },
  },
}
