# Development Environment Variables
# Copy this to .env.development for local development

# ===================================
# Cloudflare Configuration
# ===================================
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ===================================
# Alchemy Configuration
# ===================================
ALCHEMY_MANAGED=true
CONTAINER_VERSION=1.0.0
DEPLOYMENT_STRATEGY=alchemy
STAGE=dev

# ===================================
# Database Configuration (D1)
# ===================================
DATABASE_NAME=finance-manager-db

# ===================================
# KV Storage
# ===================================
KV_NAMESPACE_ID=dev-kv-id

# ===================================
# R2 Storage
# ===================================
R2_BUCKET_NAME=dev-documents-bucket

# ===================================
# Vectorize
# ===================================
VECTORIZE_INDEX_NAME=dev-documents-index
VECTORIZE_NAMESPACE=finance-manager-dev

# ===================================
# Authentication
# ===================================
JWT_SECRET=dev-jwt-secret-change-for-production
AUTH_SESSION_DURATION=7d

# ===================================
# Email (SES)
# ===================================
SES_FROM_EMAIL=no-reply@dev.finance-manager.com
SES_FROM_NAME=Finance Manager Dev

# ===================================
# AWS Configuration (for SES)
# ===================================
AWS_REGION=us-east-1

# ===================================
# Go Backend
# ===================================
GO_CONTAINER_PORT=8080
GO_CONTAINER_MAX_INSTANCES=5

# ===================================
# Feature Flags
# ===================================
FEATURE_FILE_UPLOAD_ENABLED=true
FEATURE_AI_CATEGORIZATION_ENABLED=true
FEATURE_MULTI_ENTITY_ENABLED=true
FEATURE_TAX_CALCULATION_ENABLED=false
