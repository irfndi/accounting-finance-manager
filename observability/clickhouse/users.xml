    <users>
        <!-- Default user -->
        <default>
            <password></password>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <access_management>1</access_management>
        </default>

        <!-- SigNoz user -->
        <signoz>
            <password>signoz</password>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>signoz</profile>
            <quota>default</quota>
            <access_management>1</access_management>
            <grants>
                <query>GRANT ALL ON *.*</query>
            </grants>
        </signoz>
    </users>

    <quotas>
        <default>
            <interval>
                <duration>3600</duration>
                <queries>0</queries>
                <errors>0</errors>
                <result_rows>0</result_rows>
                <read_rows>0</read_rows>
                <execution_time>0</execution_time>
            </interval>
        </default>
