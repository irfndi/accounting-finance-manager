{
  "name": "finance-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Corporate Finance Manager - A comprehensive financial management application",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "vite dev --host --port 3000",
    "dev:worker": "alchemy dev",
    "dev:all": "concurrently \"pnpm dev\" \"pnpm dev:worker\"",
    "build": "tsc --build && vite build",
    "build:web": "vite build",
    "build:worker": "tsc --build",
    "preview": "vite preview",
    "deploy": "alchemy deploy",
    "deploy:wrangler": "wrangler deploy",
    "deploy:prod": "alchemy deploy --env production",
    "deploy:prod:wrangler": "wrangler deploy --env production",
    "destroy": "alchemy destroy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:install": "playwright install",
    "test:all": "pnpm test && pnpm test:e2e",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "alchemy run --env development -- wrangler d1 migrations apply finance-manager-db",
    "db:migrate:prod": "alchemy run --env production -- wrangler d1 migrations apply finance-manager-db-prod",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:check": "drizzle-kit check",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "prettier --write .",
    "clean": "rm -rf dist .astro node_modules/.cache",
    "tail": "alchemy run --env development -- wrangler tail",
    "tail:prod": "alchemy run --env production -- wrangler tail",
    "types": "alchemy run -- wrangler types"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@cloudflare/kv-asset-handler": "^0.4.1",
    "@hono/zod-validator": "^0.7.5",
    "@noble/hashes": "^2.0.1",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-router": "^1.140.0",
    "alchemy": "^0.80.1",
    "argon2": "^0.44.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.0",
    "drizzle-zod": "^0.8.3",
    "excelize-wasm": "^0.1.0",
    "hono": "^4.10.7",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^3.0.4",
    "lucide-react": "^0.556.0",
    "openai": "^6.10.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@cloudflare/vitest-pool-workers": "^0.10.14",
    "@cloudflare/workers-types": "^4.20251205.0",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/vite": "^4.1.17",
    "@tanstack/react-query-devtools": "^5.91.1",
    "@tanstack/react-router-devtools": "^1.140.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/runner": "^3.2.4",
    "@vitest/snapshot": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "better-sqlite3": "^12.5.0",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.8",
    "jsdom": "^27.3.0",
    "miniflare": "^4.20251202.1",
    "oxlint": "^1.31.0",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vitest": "^3.2.4",
    "wrangler": "^4.53.0"
  },
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "keywords": [
    "finance",
    "accounting",
    "cloudflare",
    "react",
    "typescript",
    "d1",
    "worker"
  ],
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "astro"
      ]
    }
  }
}
