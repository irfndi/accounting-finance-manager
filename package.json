{
  "name": "finance-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Corporate Finance Manager - A comprehensive financial management application",
  "scripts": {
    "dev": "concurrently \"cd apps/web && bun run dev\" \"cd backend && go run cmd/main.go\"",
    "dev:web": "cd apps/web && bun run dev",
    "dev:api": "cd backend && go run cmd/main.go",
    "build": "cd apps/web && bun run build",
    "build:api": "cd backend && go build -o main cmd/main.go",
    "preview": "cd apps/web && bun run preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --config=vitest.coverage.config.ts --coverage",
    "test:coverage:watch": "vitest --config=vitest.coverage.config.ts --coverage --watch",
    "test:ui": "vitest --ui --coverage.enabled=true",
    "test:web": "cd apps/web && bun run test",
    "test:api": "cd backend && go test ./...",
    "test:e2e": "playwright test --config=playwright.minimal.config.ts",
    "test:e2e:headless": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:install": "playwright install",
    "test:all": "bun run test:web && bun run test:api && bun run test:e2e",
    "test:ci": "cd apps/web && bun run test:ci",
    "db:generate": "cd backend && go generate ./...",
    "db:migrate": "cd backend && go run cmd/migrate.go",
    "db:studio": "cd backend && go run cmd/studio.go",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "prettier --write .",
    "clean": "rm -rf dist .astro node_modules/.cache",
    "clean:all": "rm -rf node_modules dist .astro apps/web/node_modules apps/web/dist apps/web/.astro",
    "install:all": "bun install && cd apps/web && bun install",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "deploy:vps": "./scripts/deploy/deploy.sh"
  },
  "dependencies": {
    "concurrently": "^9.2.0",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.54.1",
    "oxlint": "^1.10.0",
    "playwright": "1.54.1",
    "prettier": "^3.3.3"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.25.0",
      "@esbuild-kit/core-utils": "latest"
    }
  },
  "overrides": {
    "undici@>=4.5.0 <5.28.5": ">=5.28.5",
    "dompurify@<3.2.4": ">=3.2.4",
    "esbuild@<=0.24.2": ">=0.25.0",
    "jspdf@<3.0.1": ">=3.0.1",
    "undici@<5.29.0": ">=5.29.0"
  },
  "engines": {
    "bun": ">=1.2.21"
  },
  "keywords": [
    "finance",
    "accounting",
    "go",
    "astro",
    "react",
    "typescript",
    "postgres",
    "docker",
    "vps"
  ]
}
