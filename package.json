{
  "name": "finance-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Corporate Finance Manager - A comprehensive financial management application",
  "main": "./alchemy.run.ts",
  "scripts": {
    "dev": "concurrently \"npm run client:dev\" \"npm run server:dev\"",
    "dev:worker": "alchemy run --env development",
    "dev:all": "pnpm dev",
    "build": "pnpm install --no-frozen-lockfile && astro check && astro build && echo '_worker.js' > dist/.assetsignore",
    "build:worker": "tsc --noEmit",
    "preview": "astro preview",
    "deploy": "pnpm dlx exec ./alchemy.run.ts",
    "deploy:wrangler": "wrangler deploy",
    "deploy:prod": "alchemy deploy --env production",
    "deploy:prod:wrangler": "wrangler deploy --env production",
    "destroy": "alchemy destroy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --config=vitest.coverage.config.ts --coverage",
    "test:coverage:watch": "vitest --config=vitest.coverage.config.ts --coverage --watch",
    "test:ui": "vitest --ui --coverage.enabled=true",
    "test:workers": "vitest run --config=vitest.config.ts",
    "test:react": "vitest run --config=vitest.react.config.ts",
    "test:e2e": "playwright test --config=playwright.minimal.config.ts",
    "test:e2e:headless": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:install": "playwright install",
    "test:all": "pnpm test && pnpm test:e2e",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=junit.xml",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "alchemy run --env development -- wrangler d1 migrations apply finance-manager-db",
    "db:migrate:prod": "alchemy run --env production -- wrangler d1 migrations apply finance-manager-db-prod",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:check": "drizzle-kit check",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "prettier --write .",
    "clean": "rm -rf dist .astro node_modules/.cache",
    "tail": "alchemy run --env development -- wrangler tail",
    "tail:prod": "alchemy run --env production -- wrangler tail",
    "types": "alchemy run -- wrangler types",
    "client:dev": "vite",
    "server:dev": "nodemon"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.55.1",
    "@astrojs/check": "^0.9.4",
    "@astrojs/cloudflare": "^12.6.2",
    "@astrojs/node": "^9.3.3",
    "@astrojs/react": "^4.3.0",
    "@cloudflare/kv-asset-handler": "^0.4.0",
    "@hono/node-server": "^1.18.1",
    "@hono/zod-validator": "^0.7.2",
    "@noble/hashes": "^1.8.0",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "alchemy": "^0.41.2",
    "argon2id": "^1.0.1",
    "astro": "^5.12.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "latest",
    "drizzle-zod": "^0.8.3",
    "excelize-wasm": "^0.0.9",
    "exceljs": "^4.4.0",
    "hono": "^4.8.12",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^3.0.1",
    "lucide-react": "^0.523.0",
    "openai": "^5.12.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1",
    "typescript": "^5.9.2",
    "zod": "^3.25.76",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@cloudflare/vite-plugin": "^1.11.1",
    "@cloudflare/vitest-pool-workers": "^0.8.60",
    "@cloudflare/workers-types": "^4.20250807.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.54.1",
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.15.30",
    "@types/sql.js": "^1.4.9",
    "@vitest/coverage-istanbul": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "better-sqlite3": "^12.2.0",
    "c8": "^10.1.3",
    "concurrently": "^9.2.0",
    "drizzle-kit": "latest",
    "happy-dom": "^18.0.1",
    "jsdom": "^26.1.0",
    "miniflare": "^4.20250803.0",
    "oxlint": "^1.10.0",
    "playwright": "1.54.1",
    "sql.js": "^1.13.0",
    "tailwindcss": "^4.1.11",
    "vite": "^7.0.6",
    "vitest": "^3.2.4",
    "wrangler": "^4.28.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@vercel/node": "^5.3.6",
    "nodemon": "^3.1.10",
    "tsx": "^4.20.3"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.25.0",
      "@esbuild-kit/core-utils": "latest"
    }
  },
  "overrides": {
    "undici@>=4.5.0 <5.28.5": ">=5.28.5",
    "dompurify@<3.2.4": ">=3.2.4",
    "esbuild@<=0.24.2": ">=0.25.0",
    "jspdf@<3.0.1": ">=3.0.1",
    "undici@<5.29.0": ">=5.29.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "keywords": [
    "finance",
    "accounting",
    "cloudflare",
    "astro",
    "react",
    "typescript",
    "d1",
    "worker"
  ]
}
