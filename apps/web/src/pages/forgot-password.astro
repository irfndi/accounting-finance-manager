---
import Layout from "../layouts/Layout.astro";
import ForgotPasswordForm from "../components/ForgotPasswordForm.tsx";
---

<Layout title="Forgot Password - Finance Manager" hideNavigation={true}>
  <div class="min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8">
      <div class="text-center">
        <h2 class="text-3xl font-extrabold text-slate-900">
          Reset your password
        </h2>
        <p class="mt-3 text-sm text-slate-600">
          Enter your email address and we'll send you a link to reset your password.
        </p>
      </div>

      <div class="mt-12">
        <ForgotPasswordForm client:load />
      </div>

      <div class="text-center">
        <p class="text-sm text-slate-600">
          Remember your password?
          <a
            href="/login"
            class="font-medium text-blue-600 hover:text-blue-500 ml-1"
          >
            Sign in here
          </a>
        </p>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* Hide navigation for forgot password page */
  nav {
    display: none;
  }
</style>