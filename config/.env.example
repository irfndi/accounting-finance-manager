# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Application Environment
NODE_ENV="development"
APP_ENV="development"
APP_DEBUG="true"
APP_PORT="8080"

# Frontend Configuration
VITE_API_URL="/api"

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Database
DB_HOST="localhost"
DB_PORT="5432"
DB_NAME="finance_manager"
DB_USER="finance_user"
DB_PASSWORD="your_secure_database_password"
DB_SSL_MODE="disable"

# Database Connection Pool
DB_MAX_CONNECTIONS="25"
DB_MAX_IDLE_CONNECTIONS="5"
DB_CONNECTION_LIFETIME="5m"

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

# Redis Cache
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""
REDIS_DB="0"

# Redis Configuration
REDIS_MAX_MEMORY="256mb"
REDIS_MAX_MEMORY_POLICY="allkeys-lru"

# =============================================================================
# JWT CONFIGURATION
# =============================================================================

# JWT Tokens
JWT_SECRET="your_super_secure_jwt_secret_key_minimum_32_characters"
JWT_EXPIRY="24h"
JWT_REFRESH_EXPIRY="168h"  # 7 days

# JWT Algorithm
JWT_ALGORITHM="HS256"

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================

# SMTP Settings
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your_email@gmail.com"
SMTP_PASSWORD="your_app_password"
SMTP_FROM="noreply@yourdomain.com"
SMTP_NAME="Finance Manager"

# Email Templates
EMAIL_TEMPLATE_VERIFY="email-verify"
EMAIL_TEMPLATE_RESET="password-reset"
EMAIL_TEMPLATE_WELCOME="welcome"

# =============================================================================
# AI PROVIDER CONFIGURATION
# =============================================================================

# API Keys (Required to enable respective provider)
ANTHROPIC_API_KEY="your_anthropic_api_key_here"       # Required: Format: sk-ant-api03-...
PERPLEXITY_API_KEY="your_perplexity_api_key_here"     # Optional: Format: pplx-...
OPENAI_API_KEY="your_openai_api_key_here"             # Optional, for OpenAI/OpenRouter models. Format: sk-proj-...
GOOGLE_API_KEY="your_google_api_key_here"             # Optional, for Google Gemini models.
MISTRAL_API_KEY="your_mistral_key_here"               # Optional, for Mistral AI models.
XAI_API_KEY="YOUR_XAI_KEY_HERE"                       # Optional, for xAI AI models.
AZURE_OPENAI_API_KEY="your_azure_key_here"            # Optional, for Azure OpenAI models (requires endpoint in .taskmaster/config.json).
OLLAMA_API_KEY="your_ollama_api_key_here"             # Optional: For remote Ollama servers that require authentication.
GITHUB_API_KEY="your_github_api_key_here"             # Optional: For GitHub import/export features. Format: ghp_... or github_pat_...

# AI Model Selection
AI_MODEL_DEFAULT="claude-3-5-sonnet-20241022"
AI_MODEL_MAX_TOKENS="4000"
AI_MODEL_TEMPERATURE="0.7"

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# CORS Settings
CORS_ORIGIN="http://localhost:3000"
CORS_METHODS="GET,POST,PUT,DELETE,OPTIONS"
CORS_HEADERS="Content-Type,Authorization"

# Rate Limiting
RATE_LIMIT_REQUESTS="100"
RATE_LIMIT_WINDOW="15m"

# Password Security
PASSWORD_MIN_LENGTH="8"
PASSWORD_REQUIRE_UPPERCASE="true"
PASSWORD_REQUIRE_LOWERCASE="true"
PASSWORD_REQUIRE_NUMBERS="true"
PASSWORD_REQUIRE_SYMBOLS="true"

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================

# Upload Settings
UPLOAD_MAX_SIZE="10MB"
UPLOAD_ALLOWED_TYPES="jpg,jpeg,png,pdf,xlsx,xls,csv"
UPLOAD_STORAGE_PATH="./uploads"

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================

# Logging
LOG_LEVEL="info"
LOG_FORMAT="json"

# Analytics (Optional)
ANALYTICS_ENABLED="false"
ANALYTICS_ID=""

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# Development Settings
DEV_HOT_RELOAD="true"
DEV_MOCK_API="false"
DEV_SHOW_ERRORS="true"

# Test Configuration
TEST_DATABASE_URL="postgres://finance_user:your_secure_database_password@localhost:5432/finance_manager_test"
TEST_REDIS_URL="redis://localhost:6379/1"

# =============================================================================
# PRODUCTION CONFIGURATION
# =============================================================================

# Production Override (uncomment for production)
# NODE_ENV="production"
# APP_ENV="production"
# APP_DEBUG="false"
# LOG_LEVEL="warn"
# CORS_ORIGIN="https://yourdomain.com"