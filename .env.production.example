# Production Environment Variables
# DO NOT commit this file to git
# Copy this to .env.production for production

# ===================================
# Cloudflare Configuration
# ===================================
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ===================================
# Alchemy Configuration
# ===================================
ALCHEMY_MANAGED=true
CONTAINER_VERSION=1.0.0
DEPLOYMENT_STRATEGY=alchemy
STAGE=prod
ENVIRONMENT=production

# ===================================
# Database Configuration (D1)
# ===================================
DATABASE_NAME=finance-manager-db-prod

# ===================================
# KV Storage
# ===================================
KV_NAMESPACE_ID=prod-kv-id

# ===================================
# R2 Storage
# ===================================
R2_BUCKET_NAME=prod-documents-bucket

# ===================================
# Vectorize
# ===================================
VECTORIZE_INDEX_NAME=prod-documents-index
VECTORIZE_NAMESPACE=finance-manager-prod

# ===================================
# Authentication
# ===================================
# JWT_SECRET MUST be a strong random key (min 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE-THIS-TO-STRONG-RANDOM-KEY-MIN-32-CHARS
AUTH_SESSION_DURATION=7d

# ===================================
# Email (SES)
# ===================================
SES_FROM_EMAIL=no-reply@finance-manager.com
SES_FROM_NAME=Finance Manager

# ===================================
# AWS Configuration (for SES)
# ===================================
AWS_REGION=us-east-1

# ===================================
# Go Backend
# ===================================
GO_CONTAINER_PORT=8080
GO_CONTAINER_MAX_INSTANCES=20

# ===================================
# Feature Flags
# ===================================
FEATURE_FILE_UPLOAD_ENABLED=true
FEATURE_AI_CATEGORIZATION_ENABLED=true
FEATURE_MULTI_ENTITY_ENABLED=true
FEATURE_TAX_CALCULATION_ENABLED=true
